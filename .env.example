# TecnoFact SDK - Configuración de Ambiente
# Copia este archivo a .env y configura tus valores

# Credenciales de TecnoFact
TECNOFACT_API_KEY=tu_api_key_aqui
TECNOFACT_API_SECRET=tu_api_secret_aqui

# Ambiente (Sandbox o Production)
TECNOFACT_ENVIRONMENT=Sandbox

# Configuración de timeouts
TECNOFACT_TIMEOUT=30
TECNOFACT_RETRIES=3

# Configuración de tests
ASPNETCORE_ENVIRONMENT=Testing
DOTNET_ENVIRONMENT=Testing

# Mock API (para tests de integración)
MOCK_API_URL=http://mock-api:1080

# Codecov (para CI/CD)
CODECOV_TOKEN=tu_codecov_token_aqui

# NuGet (para publicación)
NUGET_API_KEY=tu_nuget_api_key_aqui
